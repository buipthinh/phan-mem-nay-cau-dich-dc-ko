{
  "name": "mua-thu-long-lay",
  "private": true,
  "version": "1.0.0",
  "description": "Thuyết minh tự động đa ngôn ngữ cho lễ hội ngoài trời Mùa thu lộng lẫy (app mobile + web quản trị)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "lint": "oxlint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build -w web",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10"
  }
}
