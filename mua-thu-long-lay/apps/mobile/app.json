{
  "expo": {
    "name": "Mùa thu lộng lẫy",
    "slug": "mua-thu-long-lay",
    "scheme": "muathu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F0F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edu.muathu.festival"
    },
    "android": {
      "package": "vn.edu.muathu.festival",
      "adaptiveIcon": {
        "backgroundColor": "#F2F0F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "App dùng vị trí để tự phát thuyết minh khi bạn đi vào từng khu của lễ hội."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "App dùng camera để quét mã QR ở các gian hàng."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {}
    }
  }
}
