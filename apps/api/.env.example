# Chép file này thành .env rồi sửa cho đúng máy của bạn. KHÔNG đưa file .env lên GitHub.

# Tên máy SQL Server. Máy cài SQL Server Express thường là: localhost
DB_SERVER=localhost
# Tên instance (phần sau dấu \ khi đăng nhập SSMS, ví dụ SQLEXPRESS). Để trống nếu dùng bản mặc định.
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_DATABASE=MuaThuLongLay
# Tài khoản SQL Server Authentication (tạo theo hướng dẫn README)
DB_USER=mtll_app
DB_PASSWORD=MuaThu@2026

# Cổng của API
PORT=3001
